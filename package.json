{
  "name": "cekrause-notes",
  "version": "0.1.0",
  "private": false,
  "description": "Multilingual markdown notes and build-time audio artifacts.",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "notes:validate": "node --env-file-if-exists=.env --import tsx src/cli.ts validate",
    "notes:generate": "node --env-file-if-exists=.env --import tsx src/cli.ts generate",
    "notes:dispatch": "node --env-file-if-exists=.env --import tsx src/dispatch-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run notes:validate"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "gray-matter": "^4.0.3",
    "mdast-util-to-string": "^4.0.0",
    "pino": "^10.3.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
