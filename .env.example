# Local commands read .env; exported variables take priority. Never commit secrets.
ELEVENLABS_API_KEY=
# Choose a voice in ElevenLabs, then copy its Voice ID (not its display name).
# Prefer a female narrative/conversational voice with the desired accent.
# Required for generating each language: choose a native voice for that language.
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_VOICE_ID_PT=
ELEVENLABS_VOICE_ID_JA=
# Stable long-form narration. Also supports eleven_flash_v2_5 / eleven_turbo_v2_5.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Slightly slower than normal; allowed range 0.7–1.2.
ELEVENLABS_SPEED=0.95

# Only required for --upload and remote recovery; not for local generation.
BLOB_READ_WRITE_TOKEN=
NOTES_BLOB_PREFIX=notes
NOTES_LOG_LEVEL=info

# Optional portfolio notification: configure both or leave both empty.
PORTFOLIO_DISPATCH_TOKEN=
PORTFOLIO_REPOSITORY=
